{
  "expo": {
    "name": "Rasid",
    "slug": "rasid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ssobii2.rasid"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Rasid uses your camera to photograph receipts so it can read the total for you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rasid needs access to your photos so you can pick an existing receipt photo to scan."
        }
      ]
    ]
  }
}
